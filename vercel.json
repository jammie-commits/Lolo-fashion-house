{
  "buildCommand": "npm run build",
  "outputDirectory": "site",
  "cleanUrls": false,
  "redirects": [{ "source": "/fashion.html", "destination": "/", "permanent": true }],
  "headers": [
    { "source": "/admin/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }, { "key": "Cache-Control", "value": "no-store" }] }
  ]
}
